{
  // Standalone build tsconfig for dsh-ui-appearance: identical compiler
  // settings to the package tsconfig, minus the harness project references
  // (which only exist inside the deepseek-harness checkout). Used by
  // tsdown.standalone.config.ts so the plugin builds outside the harness.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false
  },
  "references": []
}
